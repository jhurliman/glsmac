# Shared LGPL FFmpeg development distribution; no original movie assets bundled.
OPTION( GLSMAC_MOVIES "Decode original EA WVE movies with FFmpeg" ON )
IF ( GLSMAC_MOVIES )
	FIND_PACKAGE( PkgConfig QUIET )
	IF ( PkgConfig_FOUND AND NOT WIN32 )
		PKG_CHECK_MODULES( MOVIE_FFMPEG QUIET IMPORTED_TARGET libavformat libavcodec libavutil libswscale )
	ENDIF ()
	IF ( TARGET PkgConfig::MOVIE_FFMPEG )
		TARGET_LINK_LIBRARIES( ${PROJECT_NAME} PRIVATE PkgConfig::MOVIE_FFMPEG )
	ELSE ()
		FIND_PATH( MOVIE_FFMPEG_INCLUDE libavformat/avformat.h HINTS "${FFMPEG_ROOT}/include" "$ENV{FFMPEG_ROOT}/include" )
		FOREACH ( LIB avformat avcodec avutil swscale )
			FIND_LIBRARY( MOVIE_${LIB}_LIBRARY NAMES ${LIB} HINTS "${FFMPEG_ROOT}/lib" "$ENV{FFMPEG_ROOT}/lib" )
			IF ( NOT MOVIE_${LIB}_LIBRARY )
				MESSAGE( FATAL_ERROR "Missing FFmpeg ${LIB} development library; install FFmpeg or set FFMPEG_ROOT, or explicitly use -DGLSMAC_MOVIES=OFF" )
			ENDIF ()
			TARGET_LINK_LIBRARIES( ${PROJECT_NAME} PRIVATE ${MOVIE_${LIB}_LIBRARY} )
		ENDFOREACH ()
		IF ( NOT MOVIE_FFMPEG_INCLUDE )
			MESSAGE( FATAL_ERROR "FFmpeg development headers required; install FFmpeg or set FFMPEG_ROOT, or explicitly use -DGLSMAC_MOVIES=OFF" )
		ENDIF ()
		TARGET_INCLUDE_DIRECTORIES( ${PROJECT_NAME} PRIVATE ${MOVIE_FFMPEG_INCLUDE} )
		IF ( WIN32 )
			# Keep the matching shared libraries beside the executable. Never depend
			# on an unrelated FFmpeg DLL that happens to be installed on PATH.
			GET_FILENAME_COMPONENT( MOVIE_FFMPEG_ROOT "${MOVIE_FFMPEG_INCLUDE}" DIRECTORY )
			FILE( GLOB MOVIE_FFMPEG_DLLS "${MOVIE_FFMPEG_ROOT}/bin/*.dll" )
			IF ( NOT MOVIE_FFMPEG_DLLS )
				MESSAGE( FATAL_ERROR "FFmpeg shared DLLs required under FFMPEG_ROOT/bin" )
			ENDIF ()
			IF ( NOT EXISTS "${MOVIE_FFMPEG_ROOT}/LICENSE.txt" )
				MESSAGE( FATAL_ERROR "FFmpeg shared distribution must include LICENSE.txt; use tools/install_ffmpeg_windows.ps1" )
			ENDIF ()
			ADD_CUSTOM_COMMAND( TARGET ${PROJECT_NAME} POST_BUILD
				COMMAND ${CMAKE_COMMAND} -E copy_if_different ${MOVIE_FFMPEG_DLLS} "$<TARGET_FILE_DIR:${PROJECT_NAME}>"
				COMMAND ${CMAKE_COMMAND} -E copy_if_different "${MOVIE_FFMPEG_ROOT}/LICENSE.txt" "$<TARGET_FILE_DIR:${PROJECT_NAME}>/FFmpeg-LICENSE.txt" )
		ENDIF ()
	ENDIF ()
	TARGET_COMPILE_DEFINITIONS( ${PROJECT_NAME} PRIVATE GLSMAC_HAVE_MOVIES=1 )
ENDIF ()
